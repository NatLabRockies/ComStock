  <class_name>WasteHeatRecoverySummary</class_name>
  <display_name>Waste Heat Recovery Summary</display_name>
  <description>This measure reports the amount of simultaneous heating and cooling that occurs in the building, as well as heat flows for potential heat recovery.</description>
