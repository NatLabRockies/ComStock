  <class_name>TimeseriesCSVExport</class_name>
  <display_name>Timeseries CSV Export</display_name>
  <description>Exports all available hourly timeseries enduses to csv, and uses them for utility bill calculations.</description>
  <modeler_description>Requests the native EnergyPlus CSV output (OutputControl:Files) and reformats the resulting eplusmtr.csv and eplusout.csv into enduse_timeseries.csv, converting the raw SI values to kWh, kBtu, and gal and adding local, daylight savings, and UTC timestamp columns.</modeler_description>
