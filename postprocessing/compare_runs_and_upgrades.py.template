#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Any mix of runs in one dashboard, against CBECS 2018 (and AMI), with the upgrades of the run
under review if wanted: runs postprocessed here, runs already in Athena and published releases,
on one sample or several.

Fill in the settings and RUNS below; README, "Any mix of runs and upgrades", explains each. In short:
  - 'process' runs are postprocessed here (about 35 min per 100k baseline on a first pass,
    minutes on a rerun); 'athena' and 'release' runs are only read.
  - Each 'process' run names the stock estimate its sample was drawn from, and the pairing
    is checked before anything expensive starts.
  - 'process' runs on one sample and estimate share one set of weights, the run under review's.
  - INCLUDE_UPGRADES adds the upgrades of REVIEW_RUN; every other run is its baseline alone.
  - Every view draws CBECS first, then the runs in RUNS order.

Launch it in the background and read the log:
    mkdir -p logs; ( python compare_runs_and_upgrades.py; echo "EXIT=$?" ) > logs/<name>.log 2>&1 &
Success: EXIT=0 and a "results dashboard: <path>" line.
"""
import glob
import logging
import os

import comstockpostproc as cspp

# force=True: comstockpostproc.ami calls basicConfig at import, which would otherwise
# leave this call a no-op and the log without timestamps.
logging.basicConfig(level='INFO', format='%(asctime)s %(levelname)s:%(name)s:%(message)s',
                    force=True)
logger = logging.getLogger(__name__)

# ---- Settings ---------------------------------------------------------------
# What each setting does and where the files go: README, "Any mix of runs and upgrades".
COMPARISON_NAME      = 'my comparison'       # output/<COMPARISON_NAME>/ holds everything; keep it short on Windows
REVIEW_RUN           = '<run_under_review>'  # the RUNS entry under review (findings, scorecard, Measures tabs)
DELTA_REF            = '<existing_run_a>'    # the comparison run the deltas are measured against
REUSE_CACHES         = True      # False rebuilds the 'process' runs' caches, after postprocessing code or an
                                 # estimate changed. It never redraws weights; delete a run's weights file for that
CHECK_SAMPLE_PAIRING = True      # stop when a 'process' run's sample does not match its estimate

# Upgrades: those of REVIEW_RUN, which must then be a 'process' run; every other run loads its baseline
INCLUDE_UPGRADES     = False     # True loads every upgrade of REVIEW_RUN on S3: Measures tabs, plus bills and
                                 # Athena tables for each upgrade
UPGRADE_IDS_TO_SKIP  = []        # e.g. [1, 3]
TIMESERIES_LOCATIONS = {'MN': 'Minnesota', 'OH': 'Ohio', 'AZ': 'Arizona'}  # Measures-tab load shapes: state or
                                 # county ID ('G2500250') -> name, a tuple key combines several; a county adds
                                 # county tables for every upgrade (~3,100 files each)
UPGRADE_ALIASES      = False     # short upgrade names (README, "Upgrade names, plot aliases and measure IDs")

# Athena tables and exports
ATHENA_DATABASE      = 'enduse'  # for entries without `database`; keep 'enduse' for 'process' runs
ATHENA_EXPORTS       = 'auto'    # 'auto' exports what the dashboard reads; a list adds levels for every
                                 # upgrade, e.g. ['by_state_and_county']

# Outputs
MAKE_RESULTS_DASHBOARD = True    # results_dashboard/dashboard.html
INCLUDE_AMI            = True    # the AMI tab; needs each run's <run>_timeseries table
MAKE_COMPARISON_PLOTS  = False   # ComStock-vs-CBECS figures over the 'process' runs (slow); the dashboard does
                                 # not need them

# ---- Runs -------------------------------------------------------------------
# One entry per run, drawn in this order after CBECS.
#   kind='process'  postprocessed here. Required: run (its name on S3, and its Athena table prefix),
#                   s3_base_dir, estimate (the one its sample was drawn from), database, color.
#                   Optional: label; version (names its folder, output/ComStock <version>/; default
#                   run); weights ('auto' or left out: its own weights file when it fits, else its
#                   published weights, else a new draw shared by the runs on its sample; or a
#                   weights file path or s3:// URL); rebuild=True (re-export its tables, replacing
#                   published ones); acceptable_failure_percentage (default 0.25)
#   kind='athena'   already crawled: run (the table prefix), database, color; optional label
#   kind='release'  a published release: key, label, md_table, database, color; optional
#                   md_county_table, ts_table
# #009E73 (CBECS) and #CC79A7 (AMI) are taken.
RUNS = [
    dict(kind='process', run='<s3_run_name_a>', s3_base_dir='eulp/euss_com', estimate='2026R1',
         database='enduse', color='#D55E00'),
    dict(kind='process', run='<s3_run_name_b>', s3_base_dir='eulp/euss_com', estimate='2026R1',
         database='enduse', color='#8C510A'),
    dict(kind='athena',  run='<existing_run_a>', database='enduse', color='#E69F00'),
    # dict(kind='athena',  run='<existing_run_b>', database='enduse', color='#56B4E9',
    #      label='ComStock existing_run_b'),
    # dict(kind='release', key='r3_2025', database='buildstock_sdr', label='2025 R3', color='#999999',
    #      md_table='comstock_amy2018_r3_2025_md_agg_national_parquet'),
]

HERE = os.path.dirname(os.path.abspath(__file__))
TRUTH_DIR = os.path.join(HERE, 'truth_data', 'v01')


def main():
    check_declaration()
    processed = [r for r in RUNS if r['kind'] == 'process']

    # 1. Sample-to-estimate guard first: seconds per run, needs only buildstock.csv.
    if CHECK_SAMPLE_PAIRING:
        for r in processed:
            assert_sample_matches_estimate(r['run'], buildstock_path(r), r['estimate'])

    # 1b. The stock-allocation plan: who draws, who reuses its own draw, who shares whose,
    #     who uses a given file. Decided from the disk alone (each run's buildstock.csv
    #     fingerprint, the provenance in its draw file), so it can be read before anything
    #     expensive starts. Step 3 executes it.
    plan = allocation_plan(processed)

    # What is on this disk and what this pass will do with it, before anything
    # expensive starts: one line per cache, with its date (REUSE_CACHES above).
    cspp.report_caches(run_versions=[cache_version(r) for r in processed],
                       estimate_versions=sorted({r['estimate'] for r in processed}),
                       reuse=REUSE_CACHES,
                       allocations={cache_version(entry_for(d.run)): d.describe() for d in plan})

    # 2. A ComStock object for every run postprocessed here. Under REUSE_CACHES its cached
    #    simulation outputs are reloaded when they cover every upgrade it loads and are newer
    #    than the results files, and rebuilt otherwise (ComStock reload_from_cache='auto').
    objects, first_pass = {}, {}
    for r in processed:
        # step 6: on a first pass here, tables from another draw are kept, not replaced
        first_pass[r['run']] = not sim_cache_exists(cache_version(r))
        objects[r['run']] = cspp.ComStock(
            s3_base_dir=r['s3_base_dir'],
            comstock_run_name=r['run'],
            comstock_run_version=cache_version(r),
            comstock_year=2018,
            athena_table_name=None,
            truth_data_version='v01',
            buildstock_csv_name='buildstock.csv',
            acceptable_failure_percentage=r.get('acceptable_failure_percentage', 0.25),
            drop_failed_runs=True,
            color_hex=r['color'],
            skip_missing_columns=True,     # build_existing_model columns may differ between runs
            reload_from_cache='auto' if REUSE_CACHES else False,
            # upgrades only for the run under review, under INCLUDE_UPGRADES (the Upgrades settings)
            include_upgrades=loads_upgrades(r),
            upgrade_aliases=UPGRADE_ALIASES and loads_upgrades(r),
            upgrade_ids_to_skip=list(UPGRADE_IDS_TO_SKIP) if loads_upgrades(r) else [],
            timeseries_locations_to_plot=TIMESERIES_LOCATIONS if loads_upgrades(r) else {},
            )
        if r.get('label'):
            objects[r['run']].dataset_name = r['label']

    # 3. One Apportion per distinct estimate. One STOCK ALLOCATION (the random draw of a model
    #    for every building in the estimate, with weights) per estimate and sample: runs on one
    #    sample share the run under review's draw, so a difference between them is a model
    #    change, not a different draw. The plan from step 1b says what each run does; the
    #    library checks every reused draw against the run (estimate, bootstrap coefficient,
    #    sample fingerprint) and logs how its models reconcile with the run's.
    estimates = {v: stock_estimate(v) for v in sorted({r['estimate'] for r in processed})}
    if len(estimates) > 1:
        logger.warning('mixed stock estimates in this comparison: %s',
                       {r['run']: r['estimate'] for r in processed})
    before = {r['run']: objects[r['run']].allocation_id for r in processed}
    for d in plan:                       # owners come before the runs that share their draw
        r, obj = entry_for(d.run), objects[d.run]
        logger.info('%s: stock allocation: %s', d.run, d.describe())
        how = {}
        if d.action == 'reuse':
            how = dict(reload_from_cache=True)
        elif d.action == 'share':
            how = dict(allocation_path=objects[d.source].allocation_path)
        elif d.action == 'use':
            how = dict(allocation_path=d.source)
        obj.create_allocated_weights(estimates[r['estimate']], obj.get_sim_outs_for_upgrade(0), **how)
    # A run whose draw changed in this pass has stale bills (the library rebuilds them in
    # step 4, from each folder's marker) and, unless they already carry this draw, stale
    # Athena tables (step 6, from the record beside the export).
    for run in before:
        if objects[run].allocation_id != before[run]:
            logger.info('%s: stock allocation changed in this pass (%s -> %s); bills and Athena '
                        'tables built from another draw will be rebuilt', run,
                        (before[run] or 'none')[:8], (objects[run].allocation_id or 'none')[:8])

    # 4. CBECS, then scale every processed run to CBECS floor area and add utility bills.
    #    load_cbecs reads 'CBECS wide.csv' when it exists and builds it otherwise.
    cbecs = cspp.load_cbecs()
    for obj in objects.values():
        obj.create_allocated_weights_scaled_to_cbecs(
            cbecs, obj.get_sim_outs_for_upgrade(0), obj.get_allocated_weights(),
            remove_non_comstock_bldg_types_from_cbecs=True)
        # Reused when output/ComStock <v>/cached_allocated_weights_plus_bills/ holds the
        # upgrade AND was built from the run's current stock allocation (its marker); a
        # folder from another draw is rebuilt, since the S3 export reads from it.
        # REUSE_CACHES=False rebuilds every one. One per upgrade LOADED: the baseline, plus
        # every upgrade of REVIEW_RUN under INCLUDE_UPGRADES (the others load only the baseline).
        for upgrade_id in sorted(loaded_upgrades(obj)):
            obj.create_allocated_weights_plus_util_bills_for_upgrade(upgrade_id, reuse=REUSE_CACHES)
    cbecs.export_to_csv_wide()             # the dashboard reads 'CBECS wide.csv'

    # 5. The processed runs against each other and CBECS: figures (optional).
    #    COMPARISON_NAME is the output folder; the dashboard is written inside it.
    comparison = None
    if objects:
        comparison = cspp.ComStockToCBECSComparison(
            cbecs_list=[cbecs],
            comstock_list=list(objects.values()),
            name=COMPARISON_NAME,
            make_comparison_plots=MAKE_COMPARISON_PLOTS)

    if not MAKE_RESULTS_DASHBOARD:
        return

    # 6. Athena tables for the processed runs. Checks Glue first and builds only what is
    #    missing; a rerun logs "already has every table it needs". It logs and returns
    #    False rather than raising; the dashboard then says what it could not read.
    for r in processed:
        # The levels follow from the dashboard: national for every upgrade the run loaded;
        # county for the baseline with INCLUDE_AMI, for every upgrade when a TIMESERIES_LOCATIONS
        # entry is a county; ATHENA_EXPORTS adds levels. A table that lacks upgrades gets them.
        # Table existence is not weight freshness: prepare_athena_tables re-exports tables
        # whose record beside the export names another stock allocation than the run uses,
        # or none at all -- but only when this machine processed the run before or the entry
        # says rebuild=True. On a first pass here the tables may be someone else's (a
        # published run), so they are kept and the log says how to proceed.
        ok = cspp.prepare_athena_tables(objects[r['run']], database=r.get('database', ATHENA_DATABASE),
                                        timeseries=loads_upgrades(r), ami=INCLUDE_AMI,
                                        extra_exports=ATHENA_EXPORTS,
                                        rebuild=bool(r.get('rebuild')),
                                        replace_stale=bool(r.get('rebuild')) or not first_pass[r['run']])
        if not ok:
            logger.warning('%s: prepare_athena_tables reported a gap (see above); the '
                           'dashboard will state what it could not read', r['run'])

    # 7. The dashboard, about REVIEW_RUN; every other entry is a comparison, processed
    #    runs through their freshly crawled tables, and RUNS order is the order every view
    #    draws them in (after CBECS). Every run carries its own database, so the entries
    #    may live in different ones.
    review = review_entry()
    primary = objects[review['run']] if review['kind'] == 'process' else reference(review)
    comparisons = [
        cspp.AthenaRunRef.from_comstock(objects[r['run']],
                                        database=r.get('database', ATHENA_DATABASE))
        if r['kind'] == 'process' else reference(r)
        for r in RUNS if r is not review]
    dashboard = cspp.ResultsDashboard(
        primary,
        cbecs=cbecs,
        ami=cspp.load_ami() if INCLUDE_AMI else None,
        comparison_runs=comparisons,
        comparison=comparison,             # -> output/<COMPARISON_NAME>/results_dashboard/
        output_dir=None if comparison else os.path.join(HERE, 'output', COMPARISON_NAME,
                                                         'results_dashboard'),
        database=review.get('database', ATHENA_DATABASE),   # the run under review's; refs carry their own
        delta_ref=DELTA_REF,
        display_order=[r.get('run') or r.get('key') for r in RUNS],
        # every upgrade of REVIEW_RUN under INCLUDE_UPGRADES; none otherwise (a table
        # reference has no upgrade list to take them from)
        include_measures=None if loads_upgrades(review) else [],
        measure_states=TIMESERIES_LOCATIONS if loads_upgrades(review) else None,
        )
    if dashboard.skipped_reason:
        logger.warning('results dashboard skipped: %s', dashboard.skipped_reason)
    else:
        if dashboard.dropped_runs:
            logger.warning('comparison runs DROPPED (missing tables): %s', dashboard.dropped_runs)
        logger.info('results dashboard: %s', dashboard.dashboard_path)


# ---- Helpers ----------------------------------------------------------------
def check_declaration():
    """Refuse a half-filled RUNS list now, not an hour in."""
    cspp.athena_tables.export_levels(ATHENA_EXPORTS, 'ATHENA_EXPORTS')
    for r in RUNS:
        # Upgrade settings moved from the entries to the Upgrades settings at the top.
        for key, setting in (('measures', 'INCLUDE_UPGRADES'), ('upgrade_ids_to_skip', 'UPGRADE_IDS_TO_SKIP')):
            if key in r:
                raise SystemExit(f"{r.get('run') or r.get('key')}: {key}= is now {setting} in the "
                                 'Upgrades settings at the top; it applies to REVIEW_RUN')
        # weights= is the key; allocation= is its earlier name and still accepted.
        if 'allocation' in r:
            if 'weights' in r:
                raise SystemExit(f"{r.get('run') or r.get('key')}: give weights= or its earlier name "
                                 'allocation=, not both')
            r['weights'] = r.pop('allocation')
        if isinstance(r.get('weights'), str) and r['weights'].strip().lower() == 'auto':
            r['weights'] = None  # the same as leaving it out
    kinds = {'process', 'athena', 'release'}
    bad = [r for r in RUNS if r.get('kind') not in kinds]
    if bad or not RUNS:
        raise SystemExit(f'every RUNS entry needs kind in {sorted(kinds)}: {bad or "RUNS is empty"}')
    names = [r.get('run') or r.get('key') for r in RUNS]
    if any(not n or '<' in n for n in names) or '<' in DELTA_REF or '<' in REVIEW_RUN:
        raise SystemExit(f'RUNS, REVIEW_RUN or DELTA_REF still has placeholder names: {names}, '
                         f'{REVIEW_RUN!r}, {DELTA_REF!r}')
    if REVIEW_RUN not in names:
        raise SystemExit(f'REVIEW_RUN {REVIEW_RUN!r} must be one of the RUNS entries {names}')
    if len(set(names)) != len(names):
        raise SystemExit(f'RUNS lists a run twice: {names}')
    for r in RUNS:
        if r['kind'] == 'process' and not r.get('s3_base_dir'):
            raise SystemExit(f"{r['run']}: a process entry needs s3_base_dir (bucket/prefix the run "
                             'was uploaded to)')
        if r['kind'] == 'process' and not r.get('estimate'):
            raise SystemExit(f"{r['run']}: a process entry needs estimate (the stock estimation "
                             'version its sample was drawn against)')
        if r['kind'] == 'release' and not (r.get('key') and r.get('md_table')):
            raise SystemExit(f'release entries need key and md_table: {r}')
        if r.get('weights') and r['kind'] != 'process':
            raise SystemExit(f"{r.get('run') or r.get('key')}: weights= names the weights file a "
                             "'process' run must carry; an 'athena' or 'release' run keeps the "
                             'weights it was exported with')
    if INCLUDE_UPGRADES and review_entry()['kind'] != 'process':
        raise SystemExit(f'INCLUDE_UPGRADES loads the upgrades of REVIEW_RUN ({REVIEW_RUN}), which '
                         "must then be a 'process' run")
    if INCLUDE_UPGRADES and not TIMESERIES_LOCATIONS:
        logger.warning('INCLUDE_UPGRADES but TIMESERIES_LOCATIONS is empty: the measure '
                       'load-shape tab will say it has no locations')
    others = [n for n in names if n != REVIEW_RUN]
    if DELTA_REF not in others:
        raise SystemExit(f'DELTA_REF {DELTA_REF!r} must be one of the comparison runs {others}')


def review_entry():
    """The RUNS entry REVIEW_RUN names (check_declaration has made sure there is one)."""
    return next(r for r in RUNS if (r.get('run') or r.get('key')) == REVIEW_RUN)


def loads_upgrades(entry):
    """True for the one entry whose upgrades are loaded: REVIEW_RUN, under INCLUDE_UPGRADES."""
    return INCLUDE_UPGRADES and (entry.get('run') or entry.get('key')) == REVIEW_RUN


def loaded_upgrades(obj):
    """The upgrade ids a ComStock object actually holds (cache reload or fresh build)."""
    ids = obj.data.select(obj.UPGRADE_ID).unique().collect().to_series().to_list()
    return {int(i) for i in ids}


def cache_version(entry):
    """The cache folder name for a 'process' run: comstock_data/<v>, output/ComStock <v>."""
    return entry.get('version', entry['run'])


def entry_for(run):
    """The 'process' RUNS entry with this run name."""
    return next(r for r in RUNS if r.get('run') == run)


def allocation_plan(entries):
    """What this pass does with each 'process' run's stock allocation, from the disk alone:
    the run's sample fingerprint (its buildstock.csv, fetched if absent) and the provenance
    of the draw file in its output folder. The rules are in
    comstockpostproc.allocation.plan_allocations. The bootstrap coefficient is Apportion's
    default, which stock_estimate() leaves alone."""
    import inspect
    bootstrap = inspect.signature(cspp.Apportion.__init__).parameters['bootstrap_coefficient'].default
    runs = []
    for r in entries:
        own = os.path.join(HERE, 'output', f'ComStock {cache_version(r)}', cspp.allocation.FILE_NAME)
        sample_hash, _ = cspp.allocation.sample_fingerprint(buildstock_path(r))
        use, use_id = r.get('weights'), None
        if not use and not r.get('rebuild'):
            use, use_id = published_draw(r, sample_hash, bootstrap)
        runs.append(dict(run=r['run'], estimate=r['estimate'], sample_hash=sample_hash,
                         allocation=use, allocation_id=use_id,
                         status=cspp.allocation.status_of(
                             own, estimate_version=r['estimate'], bootstrap_coefficient=bootstrap,
                             sample_hash=sample_hash)))
    # Weights are a random draw, not a cache: REUSE_CACHES never redraws them. A run's own
    # file is reused when it fits; delete it (and set rebuild=True on a published run) to redraw.
    return cspp.allocation.plan_allocations(runs, review_run=REVIEW_RUN)


def published_draw(entry, sample_hash, bootstrap):
    """(url, id) of the draw a run's export published beside its tables, when it exists and
    fits this entry; (None, None) otherwise. Adopting it is what makes every machine's weights
    the published ones. Skipped under rebuild=True: the run's tables are being replaced."""
    url = cspp.allocation.published_draw_url(entry['s3_base_dir'], entry['run'])
    try:
        st = cspp.allocation.status_of(url, estimate_version=entry['estimate'],
                                       bootstrap_coefficient=bootstrap, sample_hash=sample_hash)
    except Exception as exc:                  # noqa: BLE001
        logger.warning('%s: could not look for a published draw at %s (%s)', entry['run'], url, exc)
        return None, None
    if st.state == 'valid':
        logger.info('%s: published draw found beside its export, adopting it: %s', entry['run'],
                    st.provenance.describe())
        return url, st.provenance.allocation_id
    if st.state != 'missing':
        logger.warning('%s: the published draw at %s is %s; not used', entry['run'], url, st.describe())
    return None, None


def sim_cache_exists(run_version):
    """True when this machine has processed the run before: its cached simulation outputs
    exist. Step 6 keeps tables from another draw on a first pass (they may be a published
    run's) and replaces them otherwise."""
    pattern = os.path.join(HERE, 'output', f'ComStock {run_version}', 'cached_simulation_outputs',
                           '**', 'cached_simulation_outputs_upgrade*.parquet')
    return bool(glob.glob(pattern, recursive=True))


def stock_estimate(version, truth_data_version='v01'):
    """Apportion for one stock estimation version. Its cache (output/Stock Estimation
    <version>/cached_ComStock_apportionment.parquet) is reloaded when it exists, unless
    REUSE_CACHES is False."""
    return cspp.Apportion(stock_estimation_version=version,
                          truth_data_version=truth_data_version,
                          reload_from_cache='auto' if REUSE_CACHES else False)


def buildstock_path(entry):
    """comstock_data/<v>/buildstock.csv, fetched from the run's S3 prefix if absent. Same
    key and destination ComStock.download_data uses, so the ComStock built afterwards finds
    the file in place and does not fetch it twice."""
    path = os.path.join(HERE, 'comstock_data', cache_version(entry), 'buildstock.csv')
    if not os.path.exists(path):
        import boto3
        os.makedirs(os.path.dirname(path), exist_ok=True)
        bucket, _, prefix = entry['s3_base_dir'].strip('/').partition('/')
        key = f"{prefix}/{entry['run']}/{entry['run']}/buildstock_csv/buildstock.csv"
        logger.info('downloading s3://%s/%s', bucket, key)
        boto3.resource('s3').Object(bucket, key).download_file(path)
    return path


def estimate_path(version, truth_data_version='v01'):
    """truth_data/<tdv>/<version>_building_estimate.parquet, fetched from S3 the same way
    Apportion fetches it when absent. An estimate that is not on S3 yet has to be UPLOADED
    to s3://eulp/truth_data/<tdv>/StockE/ -- both <version>_building_estimate.parquet and
    <version>_tract_list.csv -- so every machine finds it; the error says so. A file
    copied into the local folder instead works on one machine only."""
    path = os.path.join(HERE, 'truth_data', truth_data_version, f'{version}_building_estimate.parquet')
    if not os.path.exists(path):
        import boto3
        from botocore.exceptions import ClientError
        os.makedirs(os.path.dirname(path), exist_ok=True)
        key = f'truth_data/{truth_data_version}/StockE/{version}_building_estimate.parquet'
        try:
            logger.info('downloading s3://eulp/%s', key)
            boto3.resource('s3').Object('eulp', key).download_file(path)
        except ClientError as exc:
            raise FileNotFoundError(
                f'{os.path.basename(path)} is neither in {os.path.dirname(path)} nor at '
                f's3://eulp/{key} ({exc}). Upload {version}_building_estimate.parquet AND '
                f'{version}_tract_list.csv to s3://eulp/truth_data/{truth_data_version}/StockE/ '
                f'(the folder Apportion downloads from), then rerun.') from exc
    return path


def assert_sample_matches_estimate(run_name, bs_path, version):
    """Stop unless every (building type, tract) pair the run sampled exists in the estimate.

    Apportionment matches models to real buildings on building type and tract, so a
    sample drawn against one estimate and apportioned to another lands in pairs the
    other does not have. The correct pairing has zero missing pairs; the wrong one is off
    by hundreds to thousands, spread across several building types (measured 2026-09-28:
    a 2026R1 sample is missing 2,170 pairs from 2025R3, a 2025R3 sample 1,763 from
    2026R1, both 0 from their own). Every other estimate on this machine is reported
    alongside, so the message says which one the sample does match.
    """
    import polars as pl

    bs = pl.read_csv(bs_path, columns=['building_type', 'tract'], infer_schema_length=0).unique()
    if not bs.height:
        raise RuntimeError(f'{run_name}: {bs_path} has no building_type / tract rows')

    def missing_from(v):
        est = pl.read_parquet(estimate_path(v), columns=['building_type', 'tract']).unique()
        return bs.join(est, on=['building_type', 'tract'], how='anti')

    missing = missing_from(version)
    if missing.height:
        by_type = dict(missing.group_by('building_type').len()
                       .sort('len', descending=True).iter_rows())
        others = {v: missing_from(v).height for v in candidate_estimates() if v != version}
        raise RuntimeError(
            f'{run_name}: {missing.height:,} of {bs.height:,} sampled (building type, tract) pairs '
            f'are ABSENT from the {version} estimate ({by_type}), so apportioning to it would '
            f'mis-weight the run. Missing pairs against the other estimates available: '
            f'{others}. Set this entry\'s estimate to the one its sample was drawn against.')
    logger.info('%s: all %s sampled (building type, tract) pairs exist in the %s estimate '
                '-- pairing OK', run_name, f'{bs.height:,}', version)


def candidate_estimates(truth_data_version='v01'):
    """Every estimate version available to anyone: the shared S3 folder Apportion
    downloads from, plus any file that exists only locally. Listed from S3 so the
    pairing hint reads the same on every machine; if the listing fails, the hint
    covers the local files and says so. Only reached on a failed pairing, and each
    estimate it checks is fetched once (~40 MB) by estimate_path."""
    local = {os.path.basename(f).split('_building_estimate')[0]
             for f in glob.glob(os.path.join(TRUTH_DIR, '*_building_estimate.parquet'))}
    try:
        import boto3
        pages = boto3.client('s3').get_paginator('list_objects_v2').paginate(
            Bucket='eulp', Prefix=f'truth_data/{truth_data_version}/StockE/')
        remote = {os.path.basename(o['Key']).split('_building_estimate')[0]
                  for page in pages for o in page.get('Contents', [])
                  if o['Key'].endswith('_building_estimate.parquet')}
    except Exception as exc:                                   # noqa: BLE001
        logger.warning('could not list s3://eulp/truth_data/%s/StockE/ (%s); the estimate '
                       'hint covers the local files only', truth_data_version, exc)
        remote = set()
    return sorted(local | remote)


def reference(entry):
    """An AthenaRunRef for an 'athena' or 'release' entry.

    'athena' runs are addressed by the crawler's table names for their prefix; the
    assessment discovers the timeseries view itself, as it does for from_comstock.
    'release' entries pass their fields through.
    """
    if entry['kind'] == 'release':
        fields = {k: v for k, v in entry.items() if k != 'kind'}
        return cspp.AthenaRunRef(**fields)
    run = entry['run']
    return cspp.AthenaRunRef(
        key=run, label=entry.get('label', f'ComStock {run}'),
        database=entry.get('database', ATHENA_DATABASE), color=entry['color'],
        md_table=f'{run}_md_agg_national_by_state_parquet',
        md_county_table=f'{run}_md_agg_by_state_and_county_parquet',
        ts_table=f'{run}_timeseries')


