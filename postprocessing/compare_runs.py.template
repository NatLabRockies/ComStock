#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import logging
import os

import comstockpostproc as cspp


logging.basicConfig(level='INFO')  # Use DEBUG, INFO, or WARNING
logger = logging.getLogger(__name__)

# ---- Settings ---------------------------------------------------------------
# What each setting does and where the files go: README, "Template settings".

# Runs (baseline only; for upgrades use compare_runs_and_upgrades), the run under review first.
# version names the run's folder, output/ComStock <version>/ (keep it short on Windows).
# weights: 'auto' uses that folder's cached_ComStock_alloc_wts.parquet when it was drawn for this
# estimate and sample, else draws new weights there; or a weights file path or s3:// URL. RUN_B
# may name RUN_A's file to share it.
RUN_A = dict(s3_base_dir='eulp/euss_com', run='s3_baseline_run_name', version='baseline',
             acceptable_failures=0.25, color='#b2df8a', weights='auto')
RUN_B = dict(s3_base_dir='eulp/euss_com', run='s3_change_run_name', version='change',
             acceptable_failures=0.9, color='#1f78b4', weights='auto')
STOCK_ESTIMATE = '2026R1'  # MUST be the estimate both samples were drawn from; if they differ, use
                           # compare_runs_and_upgrades
REUSE_CACHES   = True      # True reuses these caches in output/ when current; False rebuilds all three:
                           #   - simulation outputs: current when newer than the results files
                           #   - apportionment: current once built
                           #   - bills: current when newer than the results files and from the same weights
                           #   Use False after postprocessing code or an estimate changed.
                           #   It never redraws weights or rebuilds the CBECS and AMI files

# Athena tables
ATHENA_DATABASE       = 'enduse'  # keep 'enduse'
REBUILD_ATHENA_TABLES = False     # True replaces all of each run's S3 exports and Athena tables with this
                                  #   pass's; a run with other weights than its tables' stops until it is True

# Outputs, all in output/<COMPARISON_NAME>/
COMPARISON_NAME        = 'CBECS 2018 vs baseline vs change'  # keep it short on Windows
MAKE_RESULTS_DASHBOARD = True   # results_dashboard/dashboard.html
INCLUDE_AMI            = False  # the dashboard's AMI tab; needs each run's <run>_timeseries table
COMPARE_TO_RELEASES    = []     # e.g. [dict(key='r3_2025', label='2025 R3', database='buildstock_sdr',
                                #   md_table='comstock_amy2018_r3_2025_md_agg_national_parquet', color='#E69F00')]
MAKE_COMPARISON_PLOTS  = False  # ComStock-vs-CBECS figures (slow); the dashboard does not need them

# Kestrel (README, "Running on Kestrel")
# On your own computer or a compute node, leave KESTREL_JOB = None: the file runs where you start it.
# On Kestrel, put your HPC project (allocation) here and run `python <this file>` on a login node; it then
# submits itself as a Slurm job. For example:
#   KESTREL_JOB = dict(account='eusscom')                                    # 12 h on a whole node
#   KESTREL_JOB = dict(account='eusscom', time='4:00:00', qos='high')        # shorter, high priority
#   KESTREL_JOB = dict(account='eusscom', partition='shared', mem='32G', cpus=4)  # a rerun from caches
KESTREL_JOB = None


def main():
    # Refuse a mistyped weights setting now, not after the runs have loaded. Run B may name
    # run A's weights file before it exists: run A is weighted first.
    cspp.allocation.weights_arguments(RUN_A['weights'])
    if not same_file(RUN_B['weights'], own_weights_file(RUN_A)):
        cspp.allocation.weights_arguments(RUN_B['weights'])

    # What is on this disk and what this pass will do with it: one log line per
    # cache (simulation outputs, apportionment, weights, bills, CBECS, AMI) with its date.
    cspp.report_caches(run_versions=[RUN_A['version'], RUN_B['version']], estimate_versions=[STOCK_ESTIMATE],
                       reuse=REUSE_CACHES, weights={r['version']: r['weights'] for r in (RUN_A, RUN_B)})
    caches = 'auto' if REUSE_CACHES else False  # 'auto': reuse a cache that fits, build what is missing

    # The two ComStock runs (settings at the top)
    comstock_a = comstock_run(RUN_A, caches)
    comstock_b = comstock_run(RUN_B, caches)

    # Stock Estimation for Apportionment. Both runs use it, so both samples must be drawn
    # from this estimate (sampling/README.md lists each bucket file with its estimate).
    stock_estimate = cspp.Apportion(stock_estimation_version=STOCK_ESTIMATE, truth_data_version='v01',
                                    reload_from_cache=caches)

    # Scale ComStock runs to the 'truth data' from StockE V3 estimates using bucket-based apportionment
    base_sim_outs = comstock_a.get_sim_outs_for_upgrade(0)
    comstock_a.create_allocated_weights(stock_estimate, base_sim_outs, weights=RUN_A['weights'])
    base_sim_outs = comstock_b.get_sim_outs_for_upgrade(0)
    comstock_b.create_allocated_weights(stock_estimate, base_sim_outs, weights=RUN_B['weights'])

    # A run's Athena tables hold one set of weights: stop here, before the bills, when a run's
    # were built with other weights (REBUILD_ATHENA_TABLES replaces them; its weights can name theirs)
    if MAKE_RESULTS_DASHBOARD:
        for name, run in (('RUN_A', comstock_a), ('RUN_B', comstock_b)):
            cspp.athena_tables.check_tables_weights(run, database=ATHENA_DATABASE,
                                                    rebuild=REBUILD_ATHENA_TABLES,
                                                    weights_setting=f"weights in {name}")

    # CBECS: reads 'CBECS wide.csv' when it exists (the results dashboard reads it too), builds it otherwise
    cbecs = cspp.load_cbecs(cbecs_year=2018, color_hex='#33a02c')

    # First scale ComStock runs to the 'truth data' from StockE V3 estimates using bucket-based apportionment
    # Then scale both ComStock runs to CBECS 2018 AND remove non-ComStock buildings from CBECS
    # This is how weights in the models are set to represent national energy consumption
    base_sim_outs = comstock_a.get_sim_outs_for_upgrade(0)
    alloc_wts = comstock_a.get_allocated_weights()
    comstock_a.create_allocated_weights_scaled_to_cbecs(cbecs, base_sim_outs, alloc_wts, remove_non_comstock_bldg_types_from_cbecs=True)
    comstock_a.create_allocated_weights_plus_util_bills_for_upgrade(0, reuse=REUSE_CACHES)

    base_sim_outs = comstock_b.get_sim_outs_for_upgrade(0)
    alloc_wts = comstock_b.get_allocated_weights()
    comstock_b.create_allocated_weights_scaled_to_cbecs(cbecs, base_sim_outs, alloc_wts, remove_non_comstock_bldg_types_from_cbecs=True)
    comstock_b.create_allocated_weights_plus_util_bills_for_upgrade(0, reuse=REUSE_CACHES)

    # TODO This (long CSV export) is not yet re-implemented
    # comstock_a.export_to_csv_long()  # Long format useful for stacking end uses and fuels
    # comstock_b.export_to_csv_long()  # Long format useful for stacking end uses and fuels

    # Compare multiple ComStock runs to one another and to CBECS. COMPARISON_NAME
    # is the output folder; the results dashboard is written inside it.
    comparison = cspp.ComStockToCBECSComparison(
        cbecs_list=[cbecs],
        comstock_list = [comstock_a, comstock_b],
        name=COMPARISON_NAME,
        make_comparison_plots=MAKE_COMPARISON_PLOTS
    )

    # ---- Results dashboard --------------------------------------
    # The assessment reads each run's Athena tables and creates none of its own,
    # so prepare_athena_tables makes sure they exist first: it checks Glue and
    # builds only what is missing (REBUILD_ATHENA_TABLES at the top replaces all of it).
    # Both log and skip rather than raising, so an AWS problem here cannot cost
    # you the plots above. See README for the full contract.
    if MAKE_RESULTS_DASHBOARD:
        for run in (comstock_a, comstock_b):
            cspp.prepare_athena_tables(run, database=ATHENA_DATABASE,
                                       ami=INCLUDE_AMI, rebuild=REBUILD_ATHENA_TABLES)

        dashboard = cspp.ResultsDashboard(
            comstock_a,                  # the run under review
            cbecs=cbecs,
            ami=cspp.load_ami() if INCLUDE_AMI else None,
            # The other local run, plus any published releases.
            comparison_runs=(
                [cspp.AthenaRunRef.from_comstock(comstock_b, database=ATHENA_DATABASE)]
                + [cspp.AthenaRunRef(**r) for r in COMPARE_TO_RELEASES]),
            comparison=comparison,       # -> output/<COMPARISON_NAME>/results_dashboard/
            database=ATHENA_DATABASE,
            )
        if dashboard.skipped_reason:
            logger.warning('results dashboard skipped: %s', dashboard.skipped_reason)
        else:
            logger.info('results dashboard: %s', dashboard.dashboard_path)

def own_weights_file(r):
    """Where a run keeps its weights: output/ComStock <version>/cached_ComStock_alloc_wts.parquet."""
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(here, 'output', f"ComStock {r['version']}", cspp.allocation.FILE_NAME)


def same_file(setting, path):
    """True when a weights setting names this local file, however the path is written."""
    if not isinstance(setting, (str, os.PathLike)) or '://' in str(setting):
        return False
    return os.path.normcase(os.path.abspath(setting)) == os.path.normcase(os.path.abspath(path))


def comstock_run(r, caches):
    """A baseline-only cspp.ComStock for one RUN_ settings dict."""
    return cspp.ComStock(
        s3_base_dir=r['s3_base_dir'],
        comstock_run_name=r['run'],
        comstock_run_version=r['version'],
        comstock_year=2018,  # Typically don't change this
        athena_table_name=None,  # Typically don't change this
        truth_data_version='v01',  # Typically don't change this
        buildstock_csv_name='buildstock.csv',  # Download buildstock.csv manually
        acceptable_failure_percentage=r['acceptable_failures'],
        drop_failed_runs=True,  # False if you want to evaluate which runs failed in raw output data
        color_hex=r['color'],
        skip_missing_columns=True,  # False if you want to ensure you have all data specified for export
        reload_from_cache=caches,  # REUSE_CACHES at the top
        include_upgrades=False,  # this template compares baselines
        )


# Code to execute the script
if __name__=="__main__":
    cspp.run_or_submit(main, KESTREL_JOB)  # main() here; on a Kestrel login node, a Slurm job that runs it
