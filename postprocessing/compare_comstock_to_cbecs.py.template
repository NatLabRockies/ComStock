#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import logging

import comstockpostproc as cspp

logging.basicConfig(level='INFO')  # Use DEBUG, INFO, or WARNING
logger = logging.getLogger(__name__)

# ---- Settings ---------------------------------------------------------------
# What each setting does and where the files go: README, "Template settings".

# Run (baseline only; for upgrades use compare_upgrades or compare_runs_and_upgrades)
S3_BASE_DIR         = 'com-sdr'      # bucket/prefix the run was uploaded to
RUN_NAME            = 's3_run_name'  # the run's name on S3, and its Athena table prefix
RUN_VERSION         = 'baseline'     # names the run's folder, output/ComStock <RUN_VERSION>/; keep it short on Windows
ACCEPTABLE_FAILURES = 0.25           # share of failed simulations tolerated
REUSE_CACHES        = True           # True reuses these caches in output/ when current; False rebuilds all three:
                                     #   - simulation outputs: current when newer than the results files
                                     #   - apportionment: current once built
                                     #   - bills: current when newer than the results files and from the same weights
                                     #   Use False after postprocessing code or an estimate changed.
                                     #   It never redraws weights or rebuilds the CBECS and AMI files

# Weights: every result is weighted by them
STOCK_ESTIMATE = '2026R1'  # MUST be the estimate the run's sample was drawn from (sampling/README.md)
WEIGHTS        = 'auto'    # 'auto': output/ComStock <RUN_VERSION>/cached_ComStock_alloc_wts.parquet when it was drawn
                           #   for this estimate and sample, else new weights saved there (delete it to redraw).
                           #   Or a weights file path or s3:// URL, e.g. a published run's, to match its results

# Athena tables and exports
ATHENA_DATABASE       = 'enduse'  # keep 'enduse'
REBUILD_ATHENA_TABLES = False     # True overwrites the run's S3 exports and Athena tables
LOCAL_EXPORTS         = []        # files for other tools in the run's folder: 'national_by_state' (csv),
                                  # 'by_state_and_county' (parquet)

# Outputs
MAKE_RESULTS_DASHBOARD = True   # results_dashboard/dashboard.html in the run's folder
INCLUDE_AMI            = False  # the dashboard's AMI tab; needs the run's <run>_timeseries table
COMPARE_TO_RELEASES    = []     # e.g. [dict(key='r3_2025', label='2025 R3', database='buildstock_sdr',
                                #   md_table='comstock_amy2018_r3_2025_md_agg_national_parquet', color='#E69F00')]
MAKE_COMPARISON_PLOTS  = False  # ComStock-vs-CBECS figures in cbecs_comparison/ (slow); the dashboard does not need them


def main():
    # Refuse a mistyped setting now, not after the run has loaded.
    cspp.allocation.weights_arguments(WEIGHTS)
    cspp.athena_tables.export_levels(LOCAL_EXPORTS, 'LOCAL_EXPORTS')

    # What is on this disk and what this pass will do with it: one log line per
    # cache (simulation outputs, apportionment, weights, bills, CBECS, AMI) with its date.
    cspp.report_caches(run_versions=[RUN_VERSION], estimate_versions=[STOCK_ESTIMATE],
                       reuse=REUSE_CACHES, weights={RUN_VERSION: WEIGHTS})
    caches = 'auto' if REUSE_CACHES else False  # 'auto': reuse a cache that fits, build what is missing

    # ComStock run
    comstock = cspp.ComStock(
        s3_base_dir=S3_BASE_DIR,  # settings at the top
        comstock_run_name=RUN_NAME,
        comstock_run_version=RUN_VERSION,
        comstock_year=2018,  # Typically don't change this
        athena_table_name=None,  # Typically don't change this
        truth_data_version='v01',  # Typically don't change this
        buildstock_csv_name='buildstock.csv',  # Download buildstock.csv manually
        acceptable_failure_percentage=ACCEPTABLE_FAILURES,
        drop_failed_runs=True,  # False if you want to evaluate which runs failed in raw output data
        color_hex='#0072B2',  # Color used to represent this run in plots
        skip_missing_columns=True,  # False if you want to ensure you have all data specified for export
        reload_from_cache=caches,  # REUSE_CACHES at the top
        include_upgrades=False,  # the CBECS comparison is baseline only
        )


    # Stock Estimation for Apportionment:
    stock_estimate = cspp.Apportion(
        stock_estimation_version=STOCK_ESTIMATE,  # settings at the top
        truth_data_version='v01',  # Typically don't change this
        reload_from_cache=caches,  # REUSE_CACHES at the top
    )

    # Scale ComStock runs to the 'truth data' from StockE V3 estimates using bucket-based apportionment
    base_sim_outs = comstock.get_sim_outs_for_upgrade(0)
    comstock.create_allocated_weights(stock_estimate, base_sim_outs, weights=WEIGHTS)  # WEIGHTS at the top

    # CBECS: reads 'CBECS wide.csv' when it exists (the results dashboard reads it too), builds it otherwise
    cbecs = cspp.load_cbecs(cbecs_year=2018, color_hex='#009E73')

    # First scale ComStock runs to the 'truth data' from StockE V3 estimates using bucket-based apportionment
    # Then scale both ComStock runs to CBECS 2018 AND remove non-ComStock buildings from CBECS
    # This is how weights in the models are set to represent national energy consumption
    base_sim_outs = comstock.get_sim_outs_for_upgrade(0)
    alloc_wts = comstock.get_allocated_weights()
    comstock.create_allocated_weights_scaled_to_cbecs(cbecs, base_sim_outs, alloc_wts, remove_non_comstock_bldg_types_from_cbecs=True)
    comstock.create_allocated_weights_plus_util_bills_for_upgrade(0, reuse=REUSE_CACHES)

    # Local copies of the metadata aggregates (LOCAL_EXPORTS at the top). Nothing here
    # reads them; the S3 exports behind the Athena tables are chosen below.
    levels = {
        # state level resolution, one single national file
        'national_by_state': {
            'geo_top_dir': 'national_by_state',
            'partition_cols': {},
            'aggregation_levels': [[comstock.STATE_ABBRV, comstock.CZ_ASHRAE]],
            'data_types': ['full'], # other options: 'detailed', 'basic' **If using multiple options, order must go from more detailed to less detailed.
            'file_types': ['csv'], # other options:'parquet'
        },
        # county resolution, files by state and county
        'by_state_and_county': {
            'geo_top_dir': 'by_state_and_county',
            'partition_cols': {
                comstock.STATE_ABBRV: 'state',
                comstock.COUNTY_ID: 'county',
            },
            'aggregation_levels': [comstock.COUNTY_ID],
            'data_types': ['full'],
            'file_types': ['parquet'],
        },
    }
    geo_exports = [levels[name] for name in LOCAL_EXPORTS if name in levels]
    if geo_exports:
        comstock.export_metadata_and_annual_results_for_upgrade(upgrade_id=0, geo_exports=geo_exports)

    # TODO Long is def not working as expected anymore...
    # comstock.export_to_csv_long()  # Long format useful for stacking end uses and fuels

    # ComStock-vs-CBECS figures (MAKE_COMPARISON_PLOTS), for the baseline. It builds its
    # plotting table only when it draws; with MAKE_COMPARISON_PLOTS False it builds nothing,
    # and the dashboard takes only its folder.
    comp = cspp.ComStockToCBECSComparison(cbecs_list=[cbecs],
                                        comstock_list=[comstock],
                                        make_comparison_plots=MAKE_COMPARISON_PLOTS,
                                        make_hvac_plots=False)

    # ---- Results dashboard --------------------------------------
    # The assessment reads this run's Athena tables and creates none of its own,
    # so prepare_athena_tables makes sure they exist first: it checks Glue and
    # builds only what is missing (REBUILD_ATHENA_TABLES at the top redoes it).
    # Both log and skip rather than raising, so an AWS problem here cannot cost
    # you the plots above. See README for the full contract.
    if MAKE_RESULTS_DASHBOARD:
        cspp.prepare_athena_tables(comstock, database=ATHENA_DATABASE, ami=INCLUDE_AMI,
                                   rebuild=REBUILD_ATHENA_TABLES)

        dashboard = cspp.ResultsDashboard(
            comstock,
            cbecs=cbecs,
            ami=cspp.load_ami() if INCLUDE_AMI else None,
            comparison_runs=[cspp.AthenaRunRef(**r) for r in COMPARE_TO_RELEASES],
            comparison=comp,             # -> output/ComStock <run>/results_dashboard/; figures in cbecs_comparison/
            database=ATHENA_DATABASE,
            )
        if dashboard.skipped_reason:
            logger.warning('results dashboard skipped: %s', dashboard.skipped_reason)
        else:
            logger.info('results dashboard: %s', dashboard.dashboard_path)

# Code to execute the script
if __name__ == "__main__":
    main()
