      <name>refrigeration_template</name>
      <display_name>Refrigeration Technology Level</display_name>
      <description>Technology level for refrigerated cases, walkins, compressors, and systems.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>advanced</default_value>
      <choices>
        <choice>
          <value>new</value>
          <display_name>new</display_name>
        </choice>
